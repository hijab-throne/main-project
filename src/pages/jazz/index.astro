---
import Layout from '../../layouts/Layout.astro';
import { breadcrumbsJsonLd } from '../../lib/structuredData.js';

const products = [
  { name: 'Shall Jazz 200×70 cm', href: '/jazz/shall-jazz-200', description: 'Shall jazz luksoz me rënie elegante.', image: '/landing_page/image00054.jpeg' },
  { name: 'Shall Krep', href: '/jazz/shall-krep', description: 'Shall krep me strukturë të veçantë dhe elegante.', image: '/landing_page/image00054.jpeg' },
];

const breadcrumbs = breadcrumbsJsonLd([
  { name: 'Kryefaqja', url: '/' },
  { name: 'Shall Jazz', url: '/jazz' },
]);
---
<Layout
  title="Shall Jazz – Shalla Hijabi Jazz në Shqipëri | Hijab Throne"
  description="Shalla jazz luksozë me rënie elegante. Ideal për ceremoni dhe raste të veçanta. Bli online në Hijab Throne."
  keywords="shall jazz, shall hijabi jazz, shall krep, jazz Shqipëri"
  jsonLd={[breadcrumbs]}
>
  <section class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Shall Jazz Hijabi</h1>
    <p class="text-gray-600 mb-8 text-base md:text-lg">
      Jazz është një material luksoz me rënie elegante dhe shkëlqim të lehtë, ideal për raste të veçanta dhe ceremoni. Në Hijab Throne ofrojmë shalla jazz në përmasa dhe stile të ndryshme.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {products.map((p) => (
        <a href={p.href} class="group block">
          <div class="aspect-square overflow-hidden rounded-lg shadow-md bg-white">
            <img src={p.image} alt={`${p.name} – Hijab Throne`} loading="lazy" width="600" height="600" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <h2 class="mt-3 text-lg font-semibold text-gray-900">{p.name}</h2>
          <p class="text-sm text-gray-600 mt-1">{p.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
