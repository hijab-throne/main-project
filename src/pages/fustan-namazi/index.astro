---
import Layout from '../../layouts/Layout.astro';
import { breadcrumbsJsonLd } from '../../lib/structuredData.js';

const products = [
  { name: 'Fustan Namazi për të Rritur', href: '/fustan-namazi/per-te-rritur', description: 'Fustan namazi cilësor për të rritur.', image: '/fustane-namazi/femije/2.jpg' },
  { name: 'Fustan Namazi për Fëmijë', href: '/fustan-namazi/per-femije', description: 'Dizajne të veçanta për të vegjlit.', image: '/fustane-namazi/femije/2.jpg' },
];

const breadcrumbs = breadcrumbsJsonLd([
  { name: 'Kryefaqja', url: '/' },
  { name: 'Fustan Namazi', url: '/fustan-namazi' },
]);
---
<Layout
  title="Fustan Namazi – Për të Rritur dhe Fëmijë | Hijab Throne"
  description="Fustanë namazi cilësorë për të rritur dhe fëmijë. Komodë, të mbuluar dhe të përshtatshëm për lutje. Bli online në Hijab Throne."
  keywords="fustan namazi, fustan namazi femije, namaz dress, mbulim namazi, fustan namazi per te rritur"
  jsonLd={[breadcrumbs]}
>
  <section class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Fustan Namazi</h1>
    <p class="text-gray-600 mb-8 text-base md:text-lg">
      Fustani i namazit ofron mbulimin e plotë të nevojshëm për lutje, duke qenë i rehatshëm dhe me cilësi premium. Në Hijab Throne ofrojmë fustanë namazi për të rritur dhe për fëmijë në dizajne të ndryshme.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {products.map((p) => (
        <a href={p.href} class="group block">
          <div class="aspect-square overflow-hidden rounded-lg shadow-md bg-white">
            <img src={p.image} alt={`${p.name} – Hijab Throne`} loading="lazy" width="600" height="600" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <h2 class="mt-3 text-lg font-semibold text-gray-900">{p.name}</h2>
          <p class="text-sm text-gray-600 mt-1">{p.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
