---
import Layout from '../../layouts/Layout.astro';
import Page from '../../page-components/chiffon/ChiffonShallGur.jsx';
import WhatsAppWidget from '../../components/WhatsAppWidget.jsx';
import { buildProductPageJsonLd } from '../../lib/productLd.js';

const pathname = '/chiffon/shall-ch-gur';
const jsonLd = buildProductPageJsonLd(pathname, [
  { name: 'Kryefaqja', url: '/' },
  { name: 'Chiffon', url: '/chiffon/shall-ch-180' },
  { name: 'Shall Chiffon me Gur', url: pathname },
]);
---
<Layout ogType="product" jsonLd={jsonLd}>
  <WhatsAppWidget client:idle />
  <Page client:idle pathname={pathname} locale="sq" />
</Layout>
