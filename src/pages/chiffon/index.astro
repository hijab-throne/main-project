---
import Layout from '../../layouts/Layout.astro';
import { breadcrumbsJsonLd } from '../../lib/structuredData.js';

const products = [
  { name: 'Shall Chiffon 180×70 cm', href: '/chiffon/shall-ch-180', description: 'Shall i lehtë dhe ajror, përmasa standarde 180×70 cm.', image: '/landing_page/lulu/DSCF6803.jpg' },
  { name: 'Shami Chiffon 150×150 cm', href: '/chiffon/shami-ch-150', description: 'Shami katrore për stile elegante.', image: '/landing_page/lulu/DSCF6803.jpg' },
  { name: 'Shall Chiffon me Gur 180×70 cm', href: '/chiffon/shall-ch-gur', description: 'Shall me gurë dekorativë për raste të veçanta.', image: '/landing_page/lulu/DSCF6803.jpg' },
];

const breadcrumbs = breadcrumbsJsonLd([
  { name: 'Kryefaqja', url: '/' },
  { name: 'Shall Chiffon', url: '/chiffon' },
]);
---
<Layout
  title="Shall Chiffon – Shalla Hijabi Chiffon në Shqipëri | Hijab Throne"
  description="Zbulo koleksionin tonë të shallave chiffon: të lehtë, elegantë dhe me cilësi premium. Shalla 180×70, shami 150×150, dhe me gur. Bli online në Hijab Throne."
  keywords="shall chiffon, shall hijabi chiffon, shami chiffon, chiffon Shqipëri"
  jsonLd={[breadcrumbs]}
>
  <section class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Shall Chiffon Hijabi</h1>
    <p class="text-gray-600 mb-8 text-base md:text-lg">
      Chiffon është materiali më i preferuar për shalla hijabi për shkak të lehtësisë, elegancës dhe pamjes së hijshme. Në Hijab Throne ofrojmë shalla chiffon në përmasa dhe stile të ndryshme, të prodhuara nga markat më të besueshme si Sedef.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {products.map((p) => (
        <a href={p.href} class="group block">
          <div class="aspect-square overflow-hidden rounded-lg shadow-md bg-white">
            <img src={p.image} alt={`${p.name} – Hijab Throne`} loading="lazy" width="600" height="600" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <h2 class="mt-3 text-lg font-semibold text-gray-900">{p.name}</h2>
          <p class="text-sm text-gray-600 mt-1">{p.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
