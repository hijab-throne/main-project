---
import Layout from '../../../layouts/Layout.astro';
import Page from '../../../page-components/jazz/ShallKrep.jsx';
import WhatsAppWidget from '../../../components/WhatsAppWidget.jsx';
import { buildProductPageJsonLd } from '../../../lib/productLd.js';

const pathname = '/en/jazz/shall-krep';
const jsonLd = buildProductPageJsonLd(pathname, [
  { name: 'Home', url: '/en' },
  { name: 'Jazz', url: '/en/jazz' },
  { name: 'Crepe Hijab', url: pathname },
]);
---
<Layout ogType="product" jsonLd={jsonLd} locale="en">
  <WhatsAppWidget client:idle />
  <Page client:load pathname="/jazz/shall-krep" locale="en" />
</Layout>
