---
import Layout from '../../../layouts/Layout.astro';
import Page from '../../../page-components/praktike/PraktikePileli.jsx';
import WhatsAppWidget from '../../../components/WhatsAppWidget.jsx';
import { buildProductPageJsonLd } from '../../../lib/productLd.js';

const pathname = '/en/praktike/pileli';
const jsonLd = buildProductPageJsonLd(pathname, [
  { name: 'Home', url: '/en' },
  { name: 'Practical', url: '/en/praktike' },
  { name: 'Pileli Instant Hijab', url: pathname },
]);
---
<Layout ogType="product" jsonLd={jsonLd}>
  <WhatsAppWidget client:idle />
  <Page client:load pathname="/praktike/pileli" locale="en" />
</Layout>
