---
import Layout from '../../../layouts/Layout.astro';
import Page from '../../../page-components/praktike/PraktikeTesettur.jsx';
import WhatsAppWidget from '../../../components/WhatsAppWidget.jsx';
import { buildProductPageJsonLd } from '../../../lib/productLd.js';

const pathname = '/en/praktike/viscon';
const jsonLd = buildProductPageJsonLd(pathname, [
  { name: 'Home', url: '/en' },
  { name: 'Practical', url: '/en/praktike' },
  { name: 'Tesettur', url: pathname },
]);
---
<Layout ogType="product" jsonLd={jsonLd} locale="en">
  <WhatsAppWidget client:idle />
  <Page client:idle pathname="/praktike/viscon" locale="en" />
</Layout>
