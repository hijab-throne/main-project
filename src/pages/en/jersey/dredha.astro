---
import Layout from '../../../layouts/Layout.astro';
import Page from '../../../page-components/jersey/ZharsMeDredha.jsx';
import WhatsAppWidget from '../../../components/WhatsAppWidget.jsx';
import { buildProductPageJsonLd } from '../../../lib/productLd.js';

const pathname = '/en/jersey/dredha';
const jsonLd = buildProductPageJsonLd(pathname, [
  { name: 'Home', url: '/en' },
  { name: 'Jersey', url: '/en/jersey' },
  { name: 'Crinkled Hijab', url: pathname },
]);
---
<Layout ogType="product" jsonLd={jsonLd} locale="en">
  <WhatsAppWidget client:idle />
  <Page client:load pathname="/jersey/dredha" locale="en" />
</Layout>
