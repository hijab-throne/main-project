---
import Layout from '../../../layouts/Layout.astro';
import { breadcrumbsJsonLd } from '../../../lib/structuredData.js';

const products = [
  { name: 'Jersey Hijab 180×70 cm', href: '/en/jersey/shall-jr-180', description: 'Soft, stretchy jersey hijab.', image: '/landing_page/image00048.jpeg' },
  { name: 'Jersey Square Hijab 200×100 cm', href: '/en/jersey/shami-jr-200', description: 'Jersey hijab perfect for full coverage.', image: '/landing_page/image00048.jpeg' },
  { name: 'Jersey Hijab with Stones 180×70 cm', href: '/en/jersey/shall-jr-gur', description: 'Jersey hijab with decorative stones.', image: '/landing_page/image00048.jpeg' },
  { name: 'Crinkled Hijab', href: '/en/jersey/dredha', description: 'Hijab with pleated crinkled texture — a distinctive style.', image: '/landing_page/image00048.jpeg' },
];

const breadcrumbs = breadcrumbsJsonLd([
  { name: 'Home', url: '/en' },
  { name: 'Jersey Hijab', url: '/en/jersey' },
]);
---
<Layout jsonLd={[breadcrumbs]} locale="en">
  <section class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Jersey Hijab Scarves</h1>
    <p class="text-gray-600 mb-8 text-base md:text-lg">
      Jersey is the softest, stretchiest hijab fabric — offering maximum comfort throughout the day. At Hijab Throne we carry jersey hijabs in various sizes and styles for every need.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {products.map((p) => (
        <a href={p.href} class="group block">
          <div class="aspect-square overflow-hidden rounded-lg shadow-md bg-white">
            <img src={p.image} alt={`${p.name} – Hijab Throne`} loading="lazy" width="600" height="600" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <h2 class="mt-3 text-lg font-semibold text-gray-900">{p.name}</h2>
          <p class="text-sm text-gray-600 mt-1">{p.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
