---
import Layout from '../../../layouts/Layout.astro';
import Page from '../../../page-components/kapuc/KapucEcardinClassic.jsx';
import WhatsAppWidget from '../../../components/WhatsAppWidget.jsx';
import { buildProductPageJsonLd } from '../../../lib/productLd.js';

const pathname = '/en/kapuc/classic';
const jsonLd = buildProductPageJsonLd(pathname, [
  { name: 'Home', url: '/en' },
  { name: 'Underscarf', url: '/en/kapuc' },
  { name: 'Classic Ecardin Ninja', url: pathname },
]);
---
<Layout ogType="product" jsonLd={jsonLd} locale="en">
  <WhatsAppWidget client:idle />
  <Page client:idle pathname="/kapuc/classic" locale="en" />
</Layout>
