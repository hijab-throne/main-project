---
import Layout from '../../../layouts/Layout.astro';
import Page from '../../../page-components/kapuc/KapucTylLehte.jsx';
import WhatsAppWidget from '../../../components/WhatsAppWidget.jsx';
import { buildProductPageJsonLd } from '../../../lib/productLd.js';

const pathname = '/en/kapuc/tyl-i-lehte';
const jsonLd = buildProductPageJsonLd(pathname, [
  { name: 'Home', url: '/en' },
  { name: 'Underscarf', url: '/en/kapuc' },
  { name: 'Light Tulle Underscarf', url: pathname },
]);
---
<Layout ogType="product" jsonLd={jsonLd}>
  <WhatsAppWidget client:idle />
  <Page client:load pathname="/kapuc/tyl-i-lehte" locale="en" />
</Layout>
