---
import Layout from '../../../layouts/Layout.astro';
import { breadcrumbsJsonLd } from '../../../lib/structuredData.js';

const items = [
  { name: 'Fashion Shows', href: '/en/aktivitete/sfiltata', description: 'Our fashion shows and runway events.', image: '/aktivitetet/sfilatat/2022/image00007.jpeg' },
  { name: 'Fairs', href: '/en/aktivitete/panaire', description: 'Fairs and exhibitions Hijab Throne participated in.', image: '/aktivitetet/panairet/2025/panair1.jpg' },
  { name: 'Donation Policy', href: '/en/aktivitete/politikat-e-dhurimit', description: 'Our donation and charity policies.', image: '/aktivitetet/politikat/img5.jpeg' },
];

const breadcrumbs = breadcrumbsJsonLd([
  { name: 'Home', url: '/en' },
  { name: 'Activities', url: '/en/aktivitete' },
]);
---
<Layout jsonLd={[breadcrumbs]}>
  <section class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Hijab Throne Activities</h1>
    <p class="text-gray-600 mb-8 text-base md:text-lg">
      Hijab Throne isn't just a store — it's a community that promotes modest fashion and shared values. Discover our latest activities.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {items.map((p) => (
        <a href={p.href} class="group block">
          <div class="aspect-square overflow-hidden rounded-lg shadow-md bg-white">
            <img src={p.image} alt={`${p.name} – Hijab Throne`} loading="lazy" width="600" height="600" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <h2 class="mt-3 text-lg font-semibold text-gray-900">{p.name}</h2>
          <p class="text-sm text-gray-600 mt-1">{p.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
