---
import Layout from '../../layouts/Layout.astro';
import Page from '../../page-components/ShamiShkelqim.jsx';
import WhatsAppWidget from '../../components/WhatsAppWidget.jsx';
import { buildProductPageJsonLd } from '../../lib/productLd.js';

const pathname = '/en/shkelqim';
const jsonLd = buildProductPageJsonLd(pathname, [
  { name: 'Home', url: '/en' },
  { name: 'Collections', url: '/en/' },
  { name: 'Shimmer Hijab', url: pathname },
]);
---
<Layout ogType="product" jsonLd={jsonLd}>
  <WhatsAppWidget client:idle />
  <Page client:load pathname="/shkelqim" locale="en" />
</Layout>
