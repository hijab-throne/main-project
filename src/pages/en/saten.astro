---
import Layout from '../../layouts/Layout.astro';
import Page from '../../page-components/saten/Saten.jsx';
import WhatsAppWidget from '../../components/WhatsAppWidget.jsx';
import { buildProductPageJsonLd } from '../../lib/productLd.js';

const pathname = '/en/saten';
const jsonLd = buildProductPageJsonLd(pathname, [
  { name: 'Home', url: '/en' },
  { name: 'Collections', url: '/en/' },
  { name: 'Satin Hijab', url: pathname },
]);
---
<Layout ogType="product" jsonLd={jsonLd} locale="en">
  <WhatsAppWidget client:idle />
  <Page client:load pathname="/saten" locale="en" />
</Layout>
