---
import Layout from '../../../layouts/Layout.astro';
import { breadcrumbsJsonLd } from '../../../lib/structuredData.js';

const products = [
  { name: 'Chiffon Hijab 180×70 cm', href: '/en/chiffon/shall-ch-180', description: 'Light, airy hijab in the standard 180×70 cm size.', image: '/landing_page/lulu/DSCF6803.jpg' },
  { name: 'Chiffon Square Hijab 150×150 cm', href: '/en/chiffon/shami-ch-150', description: 'Square chiffon hijab for elegant styles.', image: '/landing_page/lulu/DSCF6803.jpg' },
  { name: 'Chiffon Hijab with Stones 180×70 cm', href: '/en/chiffon/shall-ch-gur', description: 'Hijab with decorative stones for special occasions.', image: '/landing_page/lulu/DSCF6803.jpg' },
];

const breadcrumbs = breadcrumbsJsonLd([
  { name: 'Home', url: '/en' },
  { name: 'Chiffon Hijab', url: '/en/chiffon' },
]);
---
<Layout jsonLd={[breadcrumbs]}>
  <section class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Chiffon Hijab Scarves</h1>
    <p class="text-gray-600 mb-8 text-base md:text-lg">
      Chiffon is the most popular hijab fabric thanks to its light weight, elegance and graceful drape. At Hijab Throne we offer chiffon hijabs in different sizes and styles, made by trusted brands like Sedef.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {products.map((p) => (
        <a href={p.href} class="group block">
          <div class="aspect-square overflow-hidden rounded-lg shadow-md bg-white">
            <img src={p.image} alt={`${p.name} – Hijab Throne`} loading="lazy" width="600" height="600" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <h2 class="mt-3 text-lg font-semibold text-gray-900">{p.name}</h2>
          <p class="text-sm text-gray-600 mt-1">{p.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
