---
import Layout from '../../../layouts/Layout.astro';
import Page from '../../../page-components/chiffon/ChiffonShall150.jsx';
import WhatsAppWidget from '../../../components/WhatsAppWidget.jsx';
import { buildProductPageJsonLd } from '../../../lib/productLd.js';

const pathname = '/en/chiffon/shami-ch-150';
const jsonLd = buildProductPageJsonLd(pathname, [
  { name: 'Home', url: '/en' },
  { name: 'Chiffon', url: '/en/chiffon' },
  { name: 'Chiffon Square 150x150', url: pathname },
]);
---
<Layout ogType="product" jsonLd={jsonLd} locale="en">
  <WhatsAppWidget client:idle />
  <Page client:load pathname="/chiffon/shami-ch-150" locale="en" />
</Layout>
