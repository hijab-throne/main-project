---
import Layout from '../../layouts/Layout.astro';
import { breadcrumbsJsonLd } from '../../lib/structuredData.js';

const products = [
  { name: 'Praktik Pileli', href: '/praktike/pileli', description: 'Hijab praktik i gatshëm për veshje të shpejtë.' },
  { name: 'Fular Sportiv Duz', href: '/praktike/sportiv', description: 'Ideal për aktivitete fizike.' },
  { name: 'Namaz Örtüsü', href: '/praktike/ortusu', description: 'Mbulim praktik për kohën e namazit.' },
  { name: 'Hazir Turban', href: '/praktike/tese', description: 'Turban i gatshëm dhe elegant.' },
  { name: 'Tesettür Praktik', href: '/praktike/viscon', description: 'Me fermuar, lehtë i veshshëm.' },
  { name: 'Hijab Praktik për Fëmijë', href: '/praktike/femije', description: 'I butë dhe komod për fëmijë.' },
  { name: 'Praktik Penye Sal', href: '/praktike/penye', description: 'Kombinim shalli + kapuc i gatshëm.' },
];

const breadcrumbs = breadcrumbsJsonLd([
  { name: 'Kryefaqja', url: '/' },
  { name: 'Hijab Praktik', url: '/praktike' },
]);
---
<Layout
  title="Hijab Praktik i Gatshëm – Pileli, Turban, Namaz Örtüsü | Hijab Throne"
  description="Hijab të gatshëm për veshje të shpejtë: pileli, turban, namaz örtüsü, tesettür, fular sportiv dhe për fëmijë. Bli online në Hijab Throne."
  keywords="hijab praktik, hijab i gatshem, hazir turban, namaz ortusu, tesettur, fular sportiv"
  jsonLd={[breadcrumbs]}
>
  <section class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Hijab Praktik i Gatshëm</h1>
    <p class="text-gray-600 mb-8 text-base md:text-lg">
      Hijab praktik është zgjedhja e përsosur për kohën e shkurtër: thjesht vishet dhe ti je gati. Në Hijab Throne ofrojmë një gamë të gjerë hijabesh të gatshëm: pileli, turban, tesettür, namaz örtüsü dhe shumë të tjera.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {products.map((p) => (
        <a href={p.href} class="group block bg-white rounded-lg shadow-md p-4 hover:shadow-lg transition-shadow">
          <h2 class="text-base font-semibold text-gray-900">{p.name}</h2>
          <p class="text-sm text-gray-600 mt-1">{p.description}</p>
          <span class="text-xs text-[#8F89A9] mt-2 inline-block">Shiko →</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
