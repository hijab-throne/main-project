---
import Layout from '../../layouts/Layout.astro';
import { breadcrumbsJsonLd } from '../../lib/structuredData.js';

const items = [
  { name: 'Sfilatat', href: '/aktivitete/sfiltata', description: 'Sfilatat dhe ngjarjet tona të modës.', image: '/aktivitetet/sfilatat/2022/image00007.jpeg' },
  { name: 'Panairet', href: '/aktivitete/panaire', description: 'Panairet ku ka marrë pjesë Hijab Throne.', image: '/aktivitetet/panairet/2025/panair1.jpg' },
  { name: 'Politikat e Dhurimit', href: '/aktivitete/politikat-e-dhurimit', description: 'Politikat tona të dhurimit dhe bamirësisë.', image: '/aktivitetet/politikat/img5.jpeg' },
];

const breadcrumbs = breadcrumbsJsonLd([
  { name: 'Kryefaqja', url: '/' },
  { name: 'Aktivitetet', url: '/aktivitete' },
]);
---
<Layout
  title="Aktivitetet – Sfilatat, Panairet, Bamirësia | Hijab Throne"
  description="Sfilatat, panairet dhe iniciativat bamirëse të Hijab Throne. Mëso më shumë rreth angazhimit tonë në komunitet."
  keywords="aktivitete hijab throne, sfilata hijab, panair hijab, bamiresi"
  jsonLd={[breadcrumbs]}
>
  <section class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Aktivitetet e Hijab Throne</h1>
    <p class="text-gray-600 mb-8 text-base md:text-lg">
      Hijab Throne nuk është thjesht një dyqan — është një komunitet që promovon modën modeste dhe vlerat e bashkëndarjes. Zbulo aktivitetet tona të fundit.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {items.map((p) => (
        <a href={p.href} class="group block">
          <div class="aspect-square overflow-hidden rounded-lg shadow-md bg-white">
            <img src={p.image} alt={`${p.name} – Hijab Throne`} loading="lazy" width="600" height="600" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <h2 class="mt-3 text-lg font-semibold text-gray-900">{p.name}</h2>
          <p class="text-sm text-gray-600 mt-1">{p.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
