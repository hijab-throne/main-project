---
import Layout from '../../layouts/Layout.astro';
import Page from '../../page-components/aktivitete/Panairet.jsx';
import WhatsAppWidget from '../../components/WhatsAppWidget.jsx';
import { breadcrumbsJsonLd } from '../../lib/structuredData.js';

const breadcrumbs = breadcrumbsJsonLd([
  { name: 'Kryefaqja', url: '/' },
  { name: 'Aktivitetet', url: '/aktivitete/sfiltata' },
  { name: 'Panairet', url: '/aktivitete/panaire' },
]);
---
<Layout jsonLd={[breadcrumbs]}>
  <WhatsAppWidget client:idle />
  <Page client:load locale="sq" />
</Layout>
