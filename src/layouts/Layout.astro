---
import '../index.css';
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';
import JsonLd from '../components/astro/JsonLd.astro';
import { getSeo, SITE_URL, DEFAULT_OG_IMAGE, SITE_NAME } from '../lib/seo.js';
import {
  organizationJsonLd,
  localBusinessJsonLd,
  websiteJsonLd,
} from '../lib/structuredData.js';
import { T, stripLocale, withLocale } from '../lib/i18n.js';

const {
  title: titleOverride,
  description: descriptionOverride,
  keywords: keywordsOverride,
  image,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  hideChrome = false,
  locale: localeOverride,
} = Astro.props;

// Astro.url.pathname is unreliable inside /en/index.astro at build time
// (Astro's i18n routing strips the prefix). We prefer the explicit prop,
// then Astro.currentLocale, then pathname fallback.
const pathname = Astro.url.pathname;
const locale = localeOverride || Astro.currentLocale || (pathname.startsWith('/en') ? 'en' : 'sq');
// Build a synthetic locale-prefixed path so getSeo returns the right alternates.
const sqPath = stripLocale(pathname);
const seo = getSeo(withLocale(sqPath, locale));
const lang = T[locale]?.htmlLang || 'sq';
const ogLocale = T[locale]?.ogLocale || 'sq_AL';
const title = titleOverride || seo.title;
const description = descriptionOverride || seo.description;
const keywords = keywordsOverride || seo.keywords;
const canonical = seo.canonical;
const ogImage = image ? (image.startsWith('http') ? image : `${SITE_URL}${image}`) : DEFAULT_OG_IMAGE;

const isHome = seo.sqPath === '/' || seo.sqPath === '';
const baseJsonLd = isHome
  ? [organizationJsonLd(), localBusinessJsonLd(), websiteJsonLd()]
  : [organizationJsonLd()];
const allJsonLd = [...baseJsonLd, ...jsonLd];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="theme-color" content="#ffffff" />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />}

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sq" href={seo.alternates.sq} />
    <link rel="alternate" hreflang="en" href={seo.alternates.en} />
    <link rel="alternate" hreflang="x-default" href={seo.alternates['x-default']} />

    <link rel="icon" href="/main.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/main.svg" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    {locale === 'sq' ? <meta property="og:locale:alternate" content="en_US" /> : <meta property="og:locale:alternate" content="sq_AL" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {allJsonLd.map((data) => <JsonLd data={data} />)}
  </head>
  <body class="bg-[#F9F8FF]">
    {!hideChrome && <Header />}
    <main class="flex-grow w-full">
      <slot />
    </main>
    {!hideChrome && <Footer />}
  </body>
</html>
